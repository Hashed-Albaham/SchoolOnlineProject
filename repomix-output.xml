                'platform_fee_rate'   => $originalTx->platform_fee_rate,
                'platform_fee_amount' => $originalTx->platform_fee_amount,
                'tutor_amount'        => $originalTx->tutor_amount,
                'notes'               => $notes,
                'processed_at'        => now(),
